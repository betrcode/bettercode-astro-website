---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { company, searchIndexing, siteTitle } from '../site';
import { palette } from '../brand';

interface Props {
  /** The page's own title; the site name is added unless this is the front page. */
  title: string;
  description: string;
  /** Path of this page's canonical URL, e.g. "/" or "/2011/03/09/slug.html". */
  path: string;
  /** "website" for the front page, "article" for articles. */
  ogType?: 'website' | 'article';
  isHome?: boolean;
}

const { title, description, path, ogType = 'website', isHome = false } = Astro.props;
const fullTitle = isHome ? title : `${title} | ${siteTitle}`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!searchIndexing && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={palette.light.paper} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={palette.dark.paper} media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="/tokens.css" />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} archive`} href="/feed.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Better Code, home">
          <Logo />
        </a>
        <slot name="nav" />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>
          <strong>{company.name}</strong>
          <span class="sep" aria-hidden="true">·</span>
          <span class="mono">Org. nr {company.orgNr}</span>
          <span class="sep" aria-hidden="true">·</span>
          {company.city}, {company.country}
        </p>
        <p class="muted">© {company.founded}–{year} {company.name}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    padding-block: var(--space-5);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .brand {
    font-size: var(--step-1);
    text-decoration: none;
    color: inherit;
  }
  .site-footer {
    margin-top: var(--space-9);
    padding-block: var(--space-6);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .footer-inner p {
    margin: 0;
  }
  .sep {
    margin-inline: var(--space-2);
    color: var(--muted);
  }
</style>
