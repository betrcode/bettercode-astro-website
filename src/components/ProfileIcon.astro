---
<svg class:list={['profile-icon', `profile-icon-${name}`]} viewBox={icon.viewBox} fill="currentColor" fill-rule="evenodd" aria-hidden="true" focusable="false">
  {icon.paths.map((d) => <path d={d} />)}
</svg>

<style>
  .profile-icon {
    display: block;
    flex: none;
    height: 1.5rem;
    width: 1.5rem;
  }
  .profile-icon-crisp {
    width: auto;
    aspect-ratio: 110 / 46;
    height: 1.4rem;
  }
</style>
