---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import TestRun from '../components/TestRun.astro';
import ProfileIcon from '../components/ProfileIcon.astro';
import Email from '../components/Email.astro';
import { company, experienceYears, links, person, siteDescription } from '../site';

// The portrait is optional: drop a photo at src/assets/portrait.jpg (or .png/.webp) and it appears.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;

const work = [
  {
    title: 'Hands-on engineering',
    text: 'Most of what I build these days is TypeScript, with Java and Kotlin on the backend: event-driven systems on AWS, Kafka, gRPC and whichever database the problem calls for. I rarely type the code by hand any more, but I still read it and answer for it.',
  },
  {
    title: 'AI in software engineering',
    text: 'AI coding agents are changing what a working day looks like for a software engineer. I use them every day and help teams work out where they pay off, where they don\'t, and how to keep quality up when most of the code is no longer typed by a person.',
  },
  {
    title: 'Architecture',
    text: 'Business-critical, transaction-heavy systems, often SaaS. I design decoupled, event-driven systems that keep the business logic apart from frameworks and infrastructure, and I pick modern tools when they earn their place. Built that way, a system stays easy to change and a release is a non-event.',
  },
  {
    title: 'Building teams',
    text: "I've been team lead, development manager, product owner and Scrum Master. What I enjoy most is building engineering teams that take real ownership of what they make.",
  },
];

const profiles = [
  { icon: 'linkedin', label: 'LinkedIn', href: links.linkedin, handle: 'in/maxwenzin' },
  { icon: 'github', label: 'GitHub', href: links.github, handle: 'betrcode' },
  { icon: 'crisp', label: 'Crisp', href: links.crispProfile, handle: 'Profile and CV' },
] as const;
---
<Base title="Better Code: Max Wenzin, software engineer and architect" description={siteDescription} path="/" isHome>
  <nav class="nav" slot="nav" aria-label="Sections">
    <a href="#work">Work</a>
    <a href="#company">Company</a>
    <a href="#crisp">Crisp</a>
    <a href="#contact">Contact</a>
  </nav>

  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="eyebrow">{company.name} · {company.city} · since {company.founded}</p>
      <h1 id="hero-title">Better code, and the teams that write it</h1>
      <p class="lead measure">
        I'm {person.name}, a software engineer and architect with more than {experienceYears()} years of building
        business-critical systems. Better Code is my company.
      </p>
      <p class="actions">
        <a class="button" href="#contact">Get in touch</a>
        <a class="button button-quiet" href={links.crispProfile}>Read my CV at Crisp</a>
      </p>
    </div>
    {
      portrait && (
        <figure class="portrait">
          <Image src={portrait} alt={person.name} width={560} loading="eager" />
        </figure>
      )
    }
  </section>

  <section id="work" class="section wrap" aria-labelledby="work-title">
    <p class="eyebrow">What I do</p>
    <h2 id="work-title" class="measure">From the code up to the team</h2>
    <ol class="cards">
      {
        work.map((item, i) => (
          <li class="card">
            <span class="card-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="company" class="section wrap split" aria-labelledby="company-title">
    <div>
      <p class="eyebrow">The company</p>
      <h2 id="company-title">{company.name}</h2>
      <div class="measure">
        <p>
          Better Code is my own consulting company, founded in {company.founded} and based in {company.city}. It's how I
          work with clients, as an engineer, architect and team builder.
        </p>
        <p>The name says what I care about: code that the next person can read and safely change.</p>
      </div>
    </div>
    <TestRun />
  </section>

  <section id="crisp" class="section wrap" aria-labelledby="crisp-title">
    <p class="eyebrow">Crisp</p>
    <h2 id="crisp-title" class="measure">Consultant and <span class="nowrap">co-owner</span> at Crisp</h2>
    <div class="measure">
      <p>
        Since {person.crispSince} I have worked with clients through <a href={links.crisp}>Crisp</a> in Stockholm, where
        I am also one of the owners. Crisp is a rather different consulting company: a home for independent IT
        consultants, with no employees and no managers. Every consultant runs their own company and chooses their own
        assignments.
      </p>
      <p>
        The whole model is open source as <a href={links.crispDna}>Crisp DNA</a>.
        My consultant profile and CV are on <a href={links.crispProfile}>crisp.se</a>.
      </p>
    </div>
  </section>

  <section id="contact" class="section wrap contact" aria-labelledby="contact-title">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Get in touch</h2>
    <p class="lead measure">Email is the quickest way to reach me.</p>
    <p class="contact-email"><Email /></p>
    <ul class="profiles">
      {
        profiles.map((p) => (
          <li>
            <a href={p.href}>
              <span class="profile-icon-slot"><ProfileIcon name={p.icon} /></span>
              <span class="profile-text">
                <span class="profile-label">{p.label}</span>
                <span class="profile-handle mono">{p.handle}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .nav {
    display: flex;
    gap: var(--space-5);
    font-size: var(--step--1);
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--ink);
  }
  @media (max-width: 34rem) {
    .nav {
      display: none;
    }
  }

  .hero {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-8) var(--space-7);
  }
  @media (min-width: 56rem) {
    .hero:has(.portrait) {
      grid-template-columns: 1.6fr 1fr;
    }
  }
  .hero h1 {
    max-width: 14ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .portrait {
    margin: 0;
  }
  .portrait img {
    display: block;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }

  .section {
    padding-block: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .card {
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .card p {
    margin: 0;
    color: var(--muted);
  }
  .card-index {
    display: block;
    margin-bottom: var(--space-5);
    font-size: var(--step--1);
    color: var(--green-text);
  }

  .split {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .split {
      grid-template-columns: 1.6fr 1fr;
    }
  }
  .contact-email {
    margin-block: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .profiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .profiles a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .profiles a:hover {
    border-color: var(--green);
  }
  .profiles a :global(.profile-icon) {
    margin-inline: auto;
    color: var(--muted);
    transition: color 0.15s;
  }
  .profiles a:hover :global(.profile-icon) {
    color: var(--ink);
  }
  .profile-icon-slot {
    flex: none;
    width: 3.4rem;
  }
  .profile-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .profile-label {
    font-weight: 600;
  }
  .profile-handle {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
