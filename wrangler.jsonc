{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only: there is no Worker script, so every request is served from ./dist.
  "name": "bettercode-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // "none" serves /2011/03/09/slug.html as is. The other modes redirect it to /2011/03/09/slug,
    // which would change the legacy article URLs. "/" and "/archive/" are mapped to
    // their index.html files in public/_redirects instead.
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  // www is the canonical host. bettercode.se and new.bettercode.se are attached too, and a
  // Cloudflare Redirect Rule sends them to www (see README).
  "routes": [
    { "pattern": "www.bettercode.se", "custom_domain": true },
    { "pattern": "bettercode.se", "custom_domain": true },
    { "pattern": "new.bettercode.se", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
